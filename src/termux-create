#!/data/data/com.termux/files/usr/bin/bash
set -e
PKG_NAME="hxroot"
PKG_VERSION="1.0.0"
PKG_ARCH="aarch64"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST_DIR="$SCRIPT_DIR/../dist"
WORK_DIR="$(mktemp -d --suffix=.hxroot)"

echo "Building package ${PKG_NAME}-${PKG_VERSION}..."
mkdir -p "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin"
mkdir -p "$WORK_DIR/data/data/com.termux/files/usr/bin"
mkdir -p "$WORK_DIR/DEBIAN"
mkdir -p "$DIST_DIR"

# Copy core shebangless binaries/scripts to glibc/bin
cp -p "$SCRIPT_DIR/libhxroot.so" "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin/"
cp -p "$SCRIPT_DIR/hxroot" "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin/"
cp -p "$SCRIPT_DIR/hxconvert" "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin/"
cp -p "$SCRIPT_DIR/hxunconvert" "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin/"

# Copy bionic wrappers to usr/bin
cp -p "$SCRIPT_DIR/../usr/bin/hxroot" "$WORK_DIR/data/data/com.termux/files/usr/bin/"
cp -p "$SCRIPT_DIR/../usr/bin/hxconvert" "$WORK_DIR/data/data/com.termux/files/usr/bin/"
cp -p "$SCRIPT_DIR/../usr/bin/hxunconvert" "$WORK_DIR/data/data/com.termux/files/usr/bin/"

chmod +x "$WORK_DIR/data/data/com.termux/files/usr/glibc/bin/"* "$WORK_DIR/data/data/com.termux/files/usr/bin/hx"*

cat << 'EOF' > "$WORK_DIR/DEBIAN/control"
Package: hxroot
Version: 1.0.0
Architecture: aarch64
Maintainer: MiMoCode Agent
Depends: glibc, glibc-runner
Description: Modern fakechroot+fakeroot re-implementation with automatic proot fallback for Termux glibc
EOF

cd "$WORK_DIR"
tar -cJf control.tar.xz -C DEBIAN control
tar -cJf data.tar.xz data
echo "2.0" > debian-binary
ar rcs "$DIST_DIR/${PKG_NAME}_${PKG_VERSION}_${PKG_ARCH}.deb" debian-binary control.tar.xz data.tar.xz

cd - >/dev/null
rm -rf "$WORK_DIR"
echo "Package built successfully in dist/${PKG_NAME}_${PKG_VERSION}_${PKG_ARCH}.deb"
